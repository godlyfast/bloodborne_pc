   ]
  },
  {
   "id": "performance",
   "icon": "performance",
   "title": {
    "en": "Performance"
   },
   "description": {
    "en": "Frame rate, latency, GPU."
   },
   "items": [
    {
     "key": "fps_mode",
     "type": "choice",
