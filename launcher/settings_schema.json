{
 "comment": "The launchers' settings, shared by the Linux (GTK) and Windows (WPF) launchers: sections in order, each item's storage (ini: bbport.ini next to the game's data, which the game's menu edits too; settings: the launcher's settings.json), type, choices, default and texts. type 'special' items are drawn by the launcher's own code (folders, lists, devices). platforms: where an item appears (both when absent).",
 "version": 1,
 "sections": [
  {
   "id": "game",
   "icon": "game",
   "title": {
    "en": "Game"
   },
   "description": {
    "en": "Where the game and the saves are, languages."
   },
   "items": [
    {
     "key": "game_dir",
     "type": "special",
     "store": "settings",
     "title": {
      "en": "Game folder (CUSA03173)"
     },
     "description": {
      "en": "The unpacked game with the 1.09 update: the folder holding eboot.bin and dvdroot_ps4."
     },
     "group": {
      "en": "Folders"
     }
    },
    {
     "key": "user_dir",
     "type": "special",
     "store": "settings",
     "title": {
      "en": "Saves folder"
     },
     "description": {
      "en": "Saves and the shader cache. By default the user folder in the port's data directory."
     },
     "group": {
      "en": "Folders"
     }
    },
    {
     "key": "language",
     "type": "choice",
     "store": "settings",
     "default": "1",
     "choices_ref": "LANGUAGES",
     "title": {
      "en": "System language"
     },
     "description": {
      "en": "The console language the game sees: it decides the menu language and the confirm button."
     },
     "group": {
      "en": "Language"
     }
    },
    {
     "key": "game_text_language",
     "type": "choice",
     "store": "ini",
     "default": "auto",
     "choices_ref": "GAME_TEXT_LANGUAGES",
     "title": {
      "en": "Game text language"
     },
     "description": {
      "en": "Any language the game's files have, whatever the copy's region and the save."
     },
     "group": {
      "en": "Language"
     }
    },
    {
     "key": "game_voice_language",
     "type": "choice",
     "store": "ini",
     "default": "auto",
     "choices_ref": "GAME_VOICE_LANGUAGES",
     "title": {
      "en": "Voice language"
     },
     "description": {
      "en": "The voices from the game's files (when the copy has that language)."
     },
     "group": {
      "en": "Language"
     }
    },
    {
     "key": "skip_network_choice",
     "type": "bool",
     "store": "settings",
     "default": true,
     "title": {
      "en": "Skip the online / offline choice"
     },
     "description": {
      "en": "The game opens its main menu offline at once. Turn off for online play."
     },
     "group": {
      "en": "Start"
     }
    },
    {
     "key": "shortcut",
     "type": "special",
     "platforms": [
      "linux"
     ],
     "title": {
      "en": "Desktop shortcut"
     },
     "description": {
      "en": "Starts the game at once, with the saved settings, patches and mods."
     },
     "group": {
      "en": "Start"
     }
    }
   ]
  },
  {
   "id": "display",
   "icon": "display",
   "title": {
    "en": "Display"
   },
   "description": {
    "en": "Window, resolution and frame presentation."
   },
   "items": [
    {
     "key": "display",
     "type": "special",
     "store": "settings",
     "title": {
      "en": "Monitor"
     },
     "description": {
      "en": "The monitor the window and fullscreen open on."
     },
     "group": {
      "en": "Window"
     }
    },
    {
     "key": "fullscreen",
     "type": "bool",
     "store": "settings",
     "default": false,
     "title": {
      "en": "Fullscreen"
     },
     "description": {
      "en": "A borderless window over the whole monitor."
     },
     "group": {
      "en": "Window"
     }
    },
    {
     "key": "present_mode",
     "type": "choice",
     "store": "settings",
     "default": "Mailbox",
     "choices_ref": "PRESENT_MODES",
     "title": {
      "en": "Present mode"
     },
     "description": {
      "en": "Mailbox: no tearing, low latency; FIFO: vertical sync; Immediate: no sync (tearing, the lowest latency)."
     },
     "group": {
      "en": "Window"
     }
    },
    {
     "key": "hdr",
     "type": "bool",
     "store": "settings",
     "default": false,
     "title": {
      "en": "Allow HDR"
     },
     "description": {
      "en": "HDR output where the monitor and the system support it."
     },
     "platforms": [
      "linux"
     ],
     "group": {
      "en": "Window"
     }
    },
    {
     "key": "aspect_ratio",
     "type": "special",
     "store": "ini",
     "default": "auto",
     "title": {
      "en": "Aspect ratio"
     },
     "description": {
      "en": "Wider than 16:9 shows more at the sides, taller more above and below; the UI keeps to the screen edges."
     },
     "group": {
      "en": "Resolution"
     }
    },
    {
     "key": "output_res",
     "type": "special",
     "store": "ini",
     "default": "auto",
     "title": {
      "en": "Output resolution"
     },
     "description": {
      "en": "The size of the finished frame. The scene is drawn smaller with an upscaler. Steam Deck: 1280×800."
     },
     "group": {
      "en": "Resolution"
     }
    }
   ]
  },
  {
   "id": "graphics",
   "icon": "graphics",
   "title": {
    "en": "Graphics"
   },
   "description": {
    "en": "Upscaler, anti-aliasing, quality. All of it can be changed in the game's menu too (Insert or L3+R3)."
   },
   "items": [
    {
     "key": "upscaler",
     "type": "choice",
     "store": "ini",
     "default": "fsr4",
     "choices": [
      {
       "value": "fsr4",
       "en": "FSR 4",
       "description": {
        "en": "The best quality on AMD RDNA 3/4; slower on other GPUs."
       }
      },
      {
       "value": "fsr411",
       "en": "FSR 4.1.1",
       "description": {
        "en": "AMD's newer model (needs your own AMD DLL, see below)."
       }
      },
      {
       "value": "fsr3",
       "en": "FSR 3.1",
       "description": {
        "en": "A temporal upscaler for any GPU."
       }
      },
      {
       "value": "fsr1",
       "en": "FSR 1 (weak GPUs)",
       "description": {
        "en": "Spatial: the cheapest (about 1 ms), no frame history; the game's post runs at the scene size. For laptops and the Steam Deck."
       }
      },
      {
       "value": "dlss",
       "en": "DLSS (NVIDIA RTX)",
       "description": {
        "en": "Needs NVIDIA's library (see below)."
       }
      },
      {
       "value": "taa",
       "en": "TAA (native anti-aliasing)",
       "description": {
        "en": "Anti-aliasing without a smaller resolution."
       }
      },
      {
       "value": "off",
       "en": "Off",
       "description": {
        "en": "The scene at the output resolution."
       }
      }
     ],
     "title": {
      "en": "Upscaler"
     },
     "description": {
      "en": "Draws the scene smaller and reconstructs it at the output resolution."
     },
     "group": {
      "en": "Upscaler"
     }
    },
    {
     "key": "preset",
     "type": "choice",
     "store": "ini",
     "default": "4",
     "choices": [
      {
       "value": "0",
       "en": "Native AA"
      },
      {
       "value": "1",
       "en": "Quality (×1.5)"
      },
      {
       "value": "2",
       "en": "Balanced (×1.7)"
      },
      {
       "value": "3",
       "en": "Performance (×2)"
      },
      {
       "value": "4",
       "en": "Ultra Performance (×3)"
      }
     ],
     "title": {
      "en": "Preset"
     },
     "description": {
      "en": "How much smaller the scene is than the output per side. A smaller scene: more FPS, a softer picture."
     },
     "group": {
      "en": "Upscaler"
     }
    },
    {
     "key": "frame_generation",
     "type": "special",
     "store": "ini",
     "default": "off",
     "title": {
      "en": "Frame generation"
     },
     "description": {
      "en": "Adds frames between the game's. FSR 3.1 on any GPU (experimental); DLSS on GeForce RTX 40 and newer."
     },
     "group": {
      "en": "Upscaler"
     }
    },
    {
     "key": "upscaler_files",
     "type": "special",
     "store": "settings",
     "title": {
      "en": "Upscaler files"
     },
     "description": {
      "en": "What the chosen upscaler needs: NVIDIA's libraries for DLSS, the FSR 4 model, the FSR 4.1.1 set from your AMD DLL."
     },
     "platforms": [
      "windows"
     ],
     "group": {
      "en": "Upscaler"
     }
    },
    {
     "key": "sharpen",
     "type": "bool",
     "store": "ini",
     "default": true,
     "title": {
      "en": "Sharpening (RCAS)"
     },
     "description": {
      "en": "Sharpens after the upscaler; without one, over the game's AA or FXAA. Nearly free."
     },
     "group": {
      "en": "Upscaler"
     }
    },
    {
     "key": "sharpness",
     "type": "float",
     "store": "ini",
     "default": 0.5,
     "min": 0.0,
     "max": 2.0,
     "step": 0.05,
     "enabled_by": "sharpen",
     "title": {
      "en": "Sharpness"
     },
     "description": {
      "en": "0: unchanged, 1: AMD's maximum, above: stronger."
     },
     "group": {
      "en": "Upscaler"
     }
    },
    {
     "key": "anti_aliasing",
     "type": "choice",
     "store": "ini",
     "default": "auto",
     "choices": [
      {
       "value": "auto",
       "en": "Auto",
       "description": {
        "en": "The game's AA without an upscaler; off with one (it only blurs its input)."
       }
      },
      {
       "value": "game",
       "en": "The game's own"
      },
      {
       "value": "fxaa",
       "en": "FXAA2_GS",
       "description": {
        "en": "The game's AA step running FXAA2_GS; applied at once."
       }
      },
      {
       "value": "smaa",
       "en": "SMAA (no upscaler)",
       "description": {
        "en": "SMAA 1x on the finished scene; not with an upscaler."
       }
      },
      {
       "value": "off",
       "en": "Off"
      }
     ],
     "title": {
      "en": "Anti-aliasing"
     },
     "description": {
      "en": "Smoothing of jagged edges."
     },
     "group": {
      "en": "Image quality"
     }
    },
    {
     "key": "texture_quality",
     "type": "choice",
     "store": "ini",
     "default": "auto",
     "choices": [
      {
       "value": "auto",
       "en": "Auto",
       "description": {
        "en": "Half with 3 GB of VRAM or less, else full."
       }
      },
      {
       "value": "full",
       "en": "Full"
      },
      {
       "value": "half",
       "en": "Half",
       "description": {
        "en": "Large textures half as big per side: 25–35 % less image memory."
       }
      },
      {
       "value": "quarter",
       "en": "Quarter",
       "description": {
        "en": "A quarter per side: even less memory, visibly blurrier up close."
       }
      }
     ],
     "title": {
      "en": "Texture quality"
     },
     "description": {
      "en": "The size of large textures in VRAM (from the next area). For GPUs with 2–4 GB."
     },
     "group": {
      "en": "Image quality"
     }
    },
    {
     "key": "model_lod",
     "type": "choice",
     "store": "ini",
     "default": "0",
     "choices": [
      {
       "value": "0",
       "en": "The game's"
      },
      {
       "value": "-2",
       "en": "Highest"
      },
      {
       "value": "1",
       "en": "Lower"
      },
      {
       "value": "2",
       "en": "Lowest"
      }
     ],
     "title": {
      "en": "Model detail"
     },
     "description": {
      "en": "The level of detail of distant models (after a restart)."
     },
     "group": {
      "en": "Image quality"
     }
    },
    {
     "key": "object_motion",
     "type": "bool",
     "store": "ini",
     "default": true,
     "title": {
      "en": "Object motion vectors"
     },
     "description": {
      "en": "Less ghosting behind characters with temporal upscalers. Costs about 6 % FPS; FSR 1 does not use them."
     },
     "group": {
      "en": "Image quality"
     }
    },
    {
     "key": "vbao",
     "type": "bool",
     "store": "ini",
     "default": false,
     "title": {
      "en": "GT-VBAO occlusion"
     },
     "description": {
      "en": "A more accurate ambient occlusion in place of the game's SSAO (needs SSAO on)."
     },
     "group": {
      "en": "Image quality"
     }
    },
    {
     "key": "show_fps",
     "type": "bool",
     "store": "ini",
     "default": true,
     "title": {
      "en": "Show FPS"
     },
     "description": {
      "en": "A frame counter in the corner of the screen."
     },
     "group": {
      "en": "Image quality"
     }
    },
    {
     "key": "fsr_libraries",
     "type": "special",
     "title": {
      "en": "FSR 4.1 and DLSS libraries"
     },
     "description": {
      "en": "Your own AMD and NVIDIA files: the port does not ship them."
     },
     "platforms": [
      "linux"
     ],
     "group": {
      "en": "AMD and NVIDIA libraries"
     }
    }
   ]
  },
  {
   "id": "effects",
   "icon": "effects",
   "title": {
    "en": "Effects"
